# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# Personal Access Token from Databricks workspace: Settings -> Developer -> Access Tokens
DATABRICKS_TOKEN=dapi_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your workspace URL, no trailing slash, e.g. https://dbc-xxxxxxxx-xxxx.cloud.databricks.com
DATABRICKS_HOST=https://your-workspace-url.cloud.databricks.com

# Pay-per-token Foundation Model API endpoint name to test against.
# Leading candidate per Databricks docs: databricks-meta-llama-3-3-70b-instruct
DATABRICKS_MODEL=databricks-meta-llama-3-3-70b-instruct

# Static API key required in the X-API-Key header to call /api/v1/criticality/score.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=your-generated-key-here
